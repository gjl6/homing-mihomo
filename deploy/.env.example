# 归途 Mihomo 控制台
ADMIN_PASSWORD=请改成一个至少 12 位的强密码
ADMIN_USER=admin

# 宿主机映射端口（容器内管理台固定 8088，代理默认 7890）
MIHOMO_UI_PORT=8088
MIHOMO_PROXY_PORT=7890

# 镜像
HOMING_MIHOMO_IMAGE=homing-mihomo:1.0.0
HOMING_MIHOMO_VERSION=1.0.0

# 推送镜像时填写你的镜像仓库前缀（scripts/mihomo-publish.sh 读取本文件），例如 yourname/
HOMING_IMAGE_PREFIX=
